[
  {
    "id": "c11",
    "chapter": 1,
    "order": 1,
    "pointOfView": "引录人",
    "kind": "正文",
    "text": "‘看灯人’在约好的地方换过灯。字签只写一个‘芦’。那晚也值夜班的人，不只一位。"
  },
  {
    "id": "c12",
    "chapter": 1,
    "order": 2,
    "pointOfView": "小满",
    "kind": "正文",
    "text": "师父说掌灯的总会回来。我没见着那人正脸，只听见对方哼起了旧船歌。"
  },
  {
    "id": "c13",
    "chapter": 1,
    "order": 3,
    "pointOfView": "编者",
    "kind": "边注",
    "text": "航册另记副手也熟这首歌。此注只解释航册写法。"
  },
  {
    "id": "c21",
    "chapter": 2,
    "order": 1,
    "pointOfView": "阿岑",
    "kind": "正文",
    "text": "阿岑一直用‘看灯人’称呼来换灯的人。他管值班的都这么叫。"
  },
  {
    "id": "c22",
    "chapter": 2,
    "order": 2,
    "pointOfView": "引录人",
    "kind": "正文",
    "text": "纸背印着一截只有两个人知道的线。不过那时还没有证据能排除另一位。"
  },
  {
    "id": "c31",
    "chapter": 3,
    "order": 1,
    "pointOfView": "引录人",
    "kind": "正文",
    "text": "灯箱寄来的那封信写明签字人是韩芦。换灯的人就是他。"
  },
  {
    "id": "c32",
    "chapter": 3,
    "order": 2,
    "pointOfView": "小满",
    "kind": "正文",
    "text": "原来师父没来，当时的那声旧船歌是韩芦哼的。"
  },
  {
    "id": "c33",
    "chapter": 3,
    "order": 3,
    "pointOfView": "编者",
    "kind": "译者栏",
    "text": "回看第一回时可说明纸签如何引出韩芦，但须先读完这封信。"
  }
]
